rules_version = '2';

// Default deny: anything not matched below is inaccessible to clients.
// Cloud Functions use the Admin SDK and are not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Fields only the server may set: Strava link state and (legacy) OAuth tokens.
    function serverOnlyUserFields() {
      return ['stravaConnected', 'stravaAthleteId', 'stravaAccessToken',
              'stravaRefreshToken', 'stravaExpiresAt'];
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);

      // A new profile may not claim to be linked to Strava.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(serverOnlyUserFields()
             .removeAll(['stravaConnected']))
        && request.resource.data.get('stravaConnected', false) == false
        && request.resource.data.get('uid', userId) == userId;

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserFields())
        && request.resource.data.get('uid', userId) == userId;

      // OAuth tokens etc. Never readable or writable by any client, including the owner.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    match /workouts/{workoutId} {
      // `list` queries must filter on userId == auth.uid for these to pass.
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Shared, read-only reference data.
    match /workout_library/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Server-issued OAuth state nonces.
    match /oauthStates/{state} {
      allow read, write: if false;
    }

    // Strava webhook queue and activity links: Cloud Functions only.
    match /stravaEvents/{eventId} {
      allow read, write: if false;
    }
    match /stravaLinks/{linkId} {
      allow read, write: if false;
    }
  }
}
